# Copy to .env and fill in real values. Production (Railway) must set the same
# variables. Anything marked REQUIRED-FOR-PUSH must be present or web push is
# silently disabled for everyone (Admin -> Settings -> Member Notifications -> Push health shows a red
# alert when that happens).

# --- Database (Postgres) ---
DATABASE_URL="postgresql://user@localhost:5432/nizek_project"
DIRECT_DATABASE_URL="postgresql://user@localhost:5432/nizek_project"

# --- Better Auth (auth) ---
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same OAuth client as Google sign-in. Calendar is opt-in: only people who
# send invites on a project that uses Calendar connect it. Enable Google
# Calendar API on that Cloud project and add calendar.events on the consent
# screen. Do not use the Maps key for Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Maps (calendar invite location) ---
# Places API (New) + Geocoding API + Maps JavaScript API. Billing must be
# enabled. Restrict the key, and include Maps JavaScript API in the key’s
# API restrictions. Restart the Next server after adding it.
GOOGLE_MAPS_API_KEY=

# --- Resend (email) ---
RESEND_API_KEY=re_...
# Verified sender, e.g. Nizek <hello@nizek.com>. If unset, invites use
# onboarding@resend.dev (test sender; Resend only delivers to the account email).
RESEND_FROM=

# --- Redis (BullMQ push queue) ---
# Dedicated Redis for the push notification job queue. In production, use a
# separate instance from Centrifugo so pub/sub traffic doesn't starve job
# polling. Falls back to localhost:6379 for local dev.
REDIS_URL=redis://localhost:6379

# --- Web Push / VAPID (REQUIRED-FOR-PUSH) ---
# OS notifications (banner + sound + app badge) when the app is backgrounded or
# closed, on desktop, Android, and iOS installed PWAs.
# Generate a key pair once with:  npx web-push generate-vapid-keys
# IMPORTANT: if the public key ever changes, every device must re-subscribe
# (happens automatically on next app open), so treat the pair as long-lived.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Push worker sizing (see docs/push-architecture.md). One job = up to 50
# recipients. Per replica: PUSH_WORKER_CONCURRENCY jobs in parallel, each with
# PUSH_SEND_CONCURRENCY HTTPS sends in flight => max 200 concurrent sends at the
# defaults, which load-tests at >1,000 sends/s (target for 1k users is 100/s).
# PUSH_WORKER_CONCURRENCY=10
# PUSH_SEND_CONCURRENCY=20

# How often (ms) the worker re-dispatches PushOutbox rows the web app failed to
# enqueue (Redis blip, crash between commit and enqueue). Default: 30000.
# PUSH_OUTBOX_SWEEP_MS=30000

# Set to any truthy value to log every completed job in the worker.
# PUSH_WORKER_VERBOSE=1

# Absolute origin of the deployed app; used as the fallback link target in push
# payloads (e.g. https://app.example.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Centrifugo (realtime: bell, in-app chime, live boards) ---
# Optional in local dev (clients fall back to polling), REQUIRED in production
# for realtime UX. See centrifugo/ for the server config and Dockerfile.
# NOTE: centrifugo/config.json ships with localhost-only allowed_origins; in
# production set CENTRIFUGO_CLIENT_ALLOWED_ORIGINS (or edit the config) to the
# real app origin, and use the same HMAC secret + API key on both sides.
# Base URL only — the app appends /api/<method> itself (do NOT include /api).
NEXT_PUBLIC_CENTRIFUGO_WS=ws://localhost:8000/connection/websocket
CENTRIFUGO_HTTP_API=http://localhost:8000
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=

# Centrifugo Redis engine address. In production, use a SEPARATE Redis instance
# from REDIS_URL (BullMQ) to prevent resource contention. Centrifugo reads this
# via CENTRIFUGO_ENGINE_REDIS_ADDRESS env var at runtime.
# CENTRIFUGO_ENGINE_REDIS_ADDRESS=redis://centrifugo-redis:6379

# --- Hocuspocus (collaborative editing for sprint docs) ---
# Deployed from railway.collab.toml / Dockerfile.collab. Leaving
# NEXT_PUBLIC_COLLAB_WS unset turns collaboration off and the editor falls back
# to autosaving HTML, which is a working but last-write-wins experience.
# In production this is the collab service's public URL, e.g. wss://collab.<host>.
NEXT_PUBLIC_COLLAB_WS=ws://localhost:4500
COLLAB_PORT=4500

# --- Cloudflare R2 (file storage: uploads, branding, notification sound) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Cron (scheduled tasks: deadline reminders, log cleanup) ---
# Shared secret to authenticate cron HTTP requests. Generate with:
#   openssl rand -base64 32
# The Railway cron function (functions/deadline-reminders-cron.ts) sends this
# as a Bearer token.
CRON_SECRET=

# --- Database pool ---
# Max connections in the Postgres pool per replica. Keep total across all
# replicas under Postgres max_connections (default 100).
# PG_POOL_MAX=10

# --- Vault (project credentials / password manager) ---
# REQUIRED to create, reveal, or update vault secrets. Use a long random string
# and keep it stable — changing it makes existing encrypted passwords unreadable.
# Generate one:  openssl rand -base64 32
VAULT_ENCRYPTION_KEY=
