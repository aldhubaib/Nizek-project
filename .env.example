# Copy to .env and fill in real values. Production (Railway) must set the same
# variables. Anything marked REQUIRED-FOR-PUSH must be present or web push is
# silently disabled for everyone (Admin -> Settings -> Member Notifications -> Push health shows a red
# alert when that happens).

# --- Database (Postgres) ---
DATABASE_URL="postgresql://user@localhost:5432/nizek_project"
DIRECT_DATABASE_URL="postgresql://user@localhost:5432/nizek_project"

# --- Better Auth (auth) ---
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Resend (email) ---
RESEND_API_KEY=re_...

# --- Web Push / VAPID (REQUIRED-FOR-PUSH) ---
# OS notifications (banner + sound + app badge) when the app is backgrounded or
# closed, on desktop, Android, and iOS installed PWAs.
# Generate a key pair once with:  npx web-push generate-vapid-keys
# IMPORTANT: if the public key ever changes, every device must re-subscribe
# (happens automatically on next app open), so treat the pair as long-lived.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Absolute origin of the deployed app; used as the fallback link target in push
# payloads (e.g. https://app.example.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Centrifugo (realtime: bell, in-app chime, live boards) ---
# Optional in local dev (clients fall back to polling), REQUIRED in production
# for realtime UX. See centrifugo/ for the server config and Dockerfile.
# NOTE: centrifugo/config.json ships with localhost-only allowed_origins; in
# production set CENTRIFUGO_CLIENT_ALLOWED_ORIGINS (or edit the config) to the
# real app origin, and use the same HMAC secret + API key on both sides.
# Base URL only — the app appends /api/<method> itself (do NOT include /api).
NEXT_PUBLIC_CENTRIFUGO_WS=ws://localhost:8000/connection/websocket
CENTRIFUGO_HTTP_API=http://localhost:8000
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=

# --- Hocuspocus (collaborative editing for sprint docs) ---
# Deployed from railway.collab.toml / Dockerfile.collab. Leaving
# NEXT_PUBLIC_COLLAB_WS unset turns collaboration off and the editor falls back
# to autosaving HTML, which is a working but last-write-wins experience.
# In production this is the collab service's public URL, e.g. wss://collab.<host>.
NEXT_PUBLIC_COLLAB_WS=ws://localhost:4500
COLLAB_PORT=4500

# --- Cloudflare R2 (file storage: uploads, branding, notification sound) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Vault (project credentials / password manager) ---
# REQUIRED to create, reveal, or update vault secrets. Use a long random string
# and keep it stable — changing it makes existing encrypted passwords unreadable.
# Generate one:  openssl rand -base64 32
VAULT_ENCRYPTION_KEY=
