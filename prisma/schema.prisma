generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  ADMIN
  PROJECT_MANAGER
  MEMBER
  CLIENT
}

enum SystemRole {
  ADMIN
  PM
  TECH_LEAD
  DEVELOPER
  DESIGNER
  CLIENT
}

enum Stage {
  NEW_REQUEST
  CLARIFICATION
  READY_FOR_DEV
  IN_DEVELOPMENT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  READY_FOR_RELEASE
  DONE
}

enum TaskType {
  FEATURE
  ENHANCEMENT
  BUG
  REPORTED_BUG
  DESIGN
}

enum ContractType {
  FULL_TEAM
  PART_TEAM
  FIXED
  MAINTENANCE
  STARTUP
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum EstimateAccuracy {
  WAY_OVER
  OVER
  ON_TRACK
  UNDER
  WAY_UNDER
}

// ─── Models ──────────────────────────────────────────────

model User {
  id         String     @id @default(cuid())
  clerkId    String     @unique
  email      String     @unique
  name       String?
  imageUrl   String?
  systemRole SystemRole @default(DEVELOPER)
  blocked    Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams          TeamMember[]
  projects       ProjectMember[]
  assignedTasks       Task[]    @relation("TaskAssignee")
  createdTasks        Task[]    @relation("TaskCreator")
  developerTasks      Task[]    @relation("TaskDeveloper")
  clientReviewTasks   Task[]    @relation("TaskClientReviewer")
  defaultClientProjects Project[] @relation("ProjectDefaultClient")
  taskActivities TaskActivity[] @relation("ActivityUser")
  taskComments   TaskComment[]  @relation("CommentUser")
  commentMentions TaskCommentMention[] @relation("MentionedUser")
  meetingNotes   MeetingNote[]
  noteEdits      NoteHistory[]
  assets         Asset[]
  invitations    Invitation[]

  conversations     ConversationParticipant[] @relation("ConversationMember")
  messages          Message[]                 @relation("MessageAuthor")
  messageMentions   MessageMention[]          @relation("MessageMentionedUser")
  messageReactions  MessageReaction[]         @relation("MessageReactionAuthor")
  notifications     Notification[]            @relation("NotificationRecipient")
  pushSubscriptions PushSubscription[]        @relation("PushSubscriptionMember")

  @@index([systemRole])
  @@index([blocked])
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  projects Project[]
  members  TeamMember[]
}

model TeamMember {
  id   String   @id @default(cuid())
  role TeamRole @default(MEMBER)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId String
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  logoUrl     String?

  teamId String?
  team   Team?  @relation(fields: [teamId], references: [id])

  defaultClientReviewerId String?
  defaultClientReviewer   User?  @relation("ProjectDefaultClient", fields: [defaultClientReviewerId], references: [id], onDelete: SetNull)

  maxPipelineTasks Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      ProjectMember[]
  contracts    Contract[]
  tasks        Task[]
  meetingNotes MeetingNote[]
  assets       Asset[]
  invitations  Invitation[]
  messages     Message[]
  @@index([teamId])
}


model ProjectMember {
  id   String @id @default(cuid())
  role Role   @default(MEMBER)

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleId    String?
  projectRole ProjectRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  canInviteMembers Boolean @default(false)
  canInviteClients Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
  @@index([projectId, role])
}

model ProjectRole {
  id                 String  @id @default(cuid())
  name               String  @unique
  description        String?
  isAdmin            Boolean @default(false)
  canCreateTask      Boolean @default(false)
  canModifyTask      Boolean @default(false)
  canMoveTask        Boolean @default(false)
  canDeleteTask      Boolean @default(false)
  canDeclineTask     Boolean @default(false)
  allowedStages      String?
  allowedTransitions String?

  createdAt DateTime @default(now())

  members     ProjectMember[]
  invitations Invitation[]
}

model ContractPrefix {
  id        String   @id @default(cuid())
  prefix    String   @unique
  name      String
  nextNumber Int     @default(1)
  createdAt DateTime @default(now())

  contracts Contract[]
}

model Contract {
  id           String       @id @default(cuid())
  label        String?
  code         String?      @unique
  contractType ContractType @default(FULL_TEAM)
  startDate    DateTime?
  endDate      DateTime?
  latePayment  Boolean      @default(false)

  prefixId  String?
  prefix    ContractPrefix? @relation(fields: [prefixId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([prefixId])
  @@index([endDate])
}

model Task {
  id          String   @id @default(cuid())
  taskNumber  Int      @default(0)
  title       String
  description String?
  priority          Int?
  taskType          TaskType @default(FEATURE)
  stage             Stage
  order             Int
  estimatedMinutes  Int?
  estimateAccuracy  EstimateAccuracy?

  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  developerId      String?
  developer        User?   @relation("TaskDeveloper", fields: [developerId], references: [id], onDelete: SetNull)
  clientReviewerId String?
  clientReviewer   User?   @relation("TaskClientReviewer", fields: [clientReviewerId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  archivedAt DateTime?

  answers    TaskAnswer[]
  activities TaskActivity[]
  comments   TaskComment[]
  stageLogs  StageLog[]
  notes      MeetingNote[]
  messages   Message[]

  @@unique([projectId, taskNumber])
  @@index([projectId, stage])
  @@index([projectId, order])
  @@index([projectId, archivedAt])
  @@index([assigneeId])
  @@index([createdById])
  @@index([stage, archivedAt])
  @@index([updatedAt])
  @@index([startedAt])
}

model StageLog {
  id        String   @id @default(cuid())
  stage     Stage
  enteredAt DateTime @default(now())
  exitedAt  DateTime?

  taskId String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, exitedAt])
}

model TaskComment {
  id      String @id @default(cuid())
  content String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("CommentUser", fields: [userId], references: [id], onDelete: Cascade)

  mentions    TaskCommentMention[]
  attachments CommentAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model CommentAttachment {
  id        String @id @default(cuid())
  commentId String
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  filename  String
  url       String
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())

  @@index([commentId])
}

model TaskCommentMention {
  id        String    @id @default(cuid())
  commentId String
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation("MentionedUser", fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime?

  @@unique([commentId, userId])
  @@index([userId])
  @@index([userId, readAt])
}

model TaskActivity {
  id       String  @id @default(cuid())
  action   String
  field    String?
  oldValue String?
  newValue String?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("ActivityUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId, action])
  @@index([taskId, createdAt])
  @@index([action, createdAt])
}

enum NoteType {
  MEETING_NOTE
  DECISION
  DEADLINE
  FEATURE
  ENHANCEMENT
  BUG
  REPORTED_BUG
  DESIGN
}

model MeetingNote {
  id       String   @id @default(cuid())
  title    String
  content  String
  date     DateTime
  noteType NoteType @default(MEETING_NOTE)

  dueDate     DateTime?
  completedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  history         NoteHistory[]
  reminderLogs    DeadlineReminderLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([taskId])
  @@index([projectId, date])
  @@index([noteType, completedAt, dueDate])
}

// Tracks which deadline milestone reminders were already sent so we don't spam
// project chat. offsetDays = days until due (+30 before, 0 due today, -3/-6/…
// every 3 days overdue until the note is completed).
model DeadlineReminderLog {
  id         String      @id @default(cuid())
  noteId     String
  note       MeetingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  offsetDays Int
  sentAt     DateTime    @default(now())

  @@unique([noteId, offsetDays])
  @@index([noteId])
}

model NoteHistory {
  id        String   @id @default(cuid())
  field     String
  oldValue  String?  @db.Text
  newValue  String?  @db.Text

  noteId    String
  note      MeetingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([noteId])
}

model Asset {
  id       String  @id @default(cuid())
  filename String
  url      String
  fileSize Int?
  mimeType String?

  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
}

model TaskAnswer {
  id     String @id @default(cuid())
  answer String

  taskId     String
  task       Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  questionId String
  question   DefaultQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([taskId, questionId])
  @@index([taskId])
  @@index([questionId])
}

model Invitation {
  id    String           @id @default(cuid())
  email String
  role  Role             @default(MEMBER)
  status InvitationStatus @default(PENDING)

  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  roleId      String?
  projectRole ProjectRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([email, projectId])
  @@index([email, status])
  @@index([projectId, status])
}

model PendingTeamInvite {
  id         String     @id @default(cuid())
  email      String     @unique
  firstName  String?
  lastName   String?
  systemRole SystemRole
  createdAt  DateTime   @default(now())
}

model DefaultQuestion {
  id       String   @id @default(cuid())
  question String
  type     String   @default("text")
  options  String?
  multiple  Boolean  @default(false)
  mandatory Boolean  @default(false)
  required  Boolean  @default(false)
  order     Int
  taskType TaskType @default(FEATURE)

  createdAt DateTime @default(now())

  answers TaskAnswer[]

  @@index([taskType])
}

// ─── Chat / Inbox (Centrifugo) ───────────────────────────
// Unified message model: a message belongs to exactly one thread —
// a task (taskId), a project channel (projectId), or a direct
// conversation (conversationId). Identity everywhere is User.id.

model Conversation {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  memberId       String
  member         User         @relation("ConversationMember", fields: [memberId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, memberId])
  @@index([memberId])
}

model Message {
  id             String        @id @default(cuid())
  taskId         String?
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyToId      String?
  authorId       String
  author         User          @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  kind           String        @default("message")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  mentions    MessageMention[]
  reactions   MessageReaction[]
  attachments MessageAttachment[]

  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@index([authorId])
}

model MessageMention {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  memberId  String
  member    User    @relation("MessageMentionedUser", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId])
  @@index([memberId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  memberId  String
  member    User     @relation("MessageReactionAuthor", fields: [memberId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, memberId, emoji])
  @@index([messageId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename  String
  url       String
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())

  @@index([messageId])
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String?
  linkUrl     String?
  read        Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, read, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  memberId  String
  member    User     @relation("PushSubscriptionMember", fields: [memberId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  deviceId  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([memberId, deviceId])
}

model BrandingAsset {
  id          String   @id @default(cuid())
  slot        String   @unique
  url         String
  r2Key       String
  contentType String
  fileName    String
  width       Int      @default(0)
  height      Int      @default(0)
  size        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LoginPhoto {
  id          String   @id @default(cuid())
  url         String
  r2Key       String
  contentType String?
  column      String   @default("a")
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([column, order])
}
