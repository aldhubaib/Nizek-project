FROM node:24-slim

RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Prisma schema + config must exist before npm install (postinstall runs prisma generate)
COPY prisma ./prisma
COPY prisma.config.ts ./

COPY package.json package-lock.json .npmrc ./
RUN npm install --omit=dev

COPY worker.ts ./
COPY src/lib/push-core.ts ./src/lib/
COPY src/lib/push/delivery.ts src/lib/push/outbox-core.ts ./src/lib/push/
COPY src/generated ./src/generated
COPY start-worker.sh ./
RUN chmod +x start-worker.sh

CMD ["./start-worker.sh"]
