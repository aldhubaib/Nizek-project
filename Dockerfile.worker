FROM node:24-slim

RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Prisma schema + config must exist before npm install (postinstall runs prisma generate)
COPY prisma ./prisma
COPY prisma.config.ts ./

COPY package.json package-lock.json .npmrc ./
RUN npm install --omit=dev

COPY worker.ts tsconfig.json tsconfig.worker.json ./
# The message-events fan-out runs the same src/lib modules as the web app
# (prisma, notify, centrifugo, alias masking, ...), so the whole lib comes
# along; only what worker.ts imports is actually loaded.
COPY src/lib ./src/lib
# The Prisma client (src/generated/prisma) is gitignored and NOT copied: the
# `npm install` above already generated it inside the image via postinstall,
# from the schema copied earlier. Copying it from the build context would fail
# on any clean checkout (GitHub trigger or `railway up`, which honours .gitignore).
COPY tests/stubs/server-only.ts ./tests/stubs/server-only.ts
COPY start-worker.sh ./
RUN chmod +x start-worker.sh

CMD ["./start-worker.sh"]
