{
  "health": {
    "enabled": true
  },
  "client": {
    "allowed_origins": [
      "http://localhost:3000"
    ]
  },
  "channel": {
    "namespaces": [
      {
        "name": "user",
        "presence": true,
        "history_size": 50,
        "history_ttl": "1800s",
        "force_recovery": true,
        "allow_presence_for_subscriber": true
      },
      {
        "name": "task",
        "presence": true,
        "join_leave": true,
        "history_size": 100,
        "history_ttl": "1800s",
        "force_recovery": true,
        "allow_publish_for_subscriber": true,
        "allow_presence_for_subscriber": true
      },
      {
        "name": "project",
        "presence": true,
        "join_leave": true,
        "history_size": 100,
        "history_ttl": "1800s",
        "force_recovery": true,
        "allow_publish_for_subscriber": true,
        "allow_presence_for_subscriber": true
      },
      {
        "name": "conv",
        "presence": true,
        "join_leave": true,
        "history_size": 200,
        "history_ttl": "3600s",
        "force_recovery": true,
        "allow_publish_for_subscriber": true,
        "allow_presence_for_subscriber": true
      },
      {
        "name": "presence",
        "presence": true,
        "join_leave": true,
        "allow_presence_for_subscriber": true
      }
    ]
  },
  "engine": {
    "type": "redis",
    "redis": {
      "address": "redis://localhost:6379"
    }
  }
}
