FROM node:24-slim

RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Prisma schema + config must exist before npm install (postinstall runs prisma generate)
COPY prisma ./prisma
COPY prisma.config.ts ./

COPY package.json package-lock.json .npmrc ./
RUN npm install --omit=dev

COPY collab-server.ts ./
# tsx resolves the "@/*" alias from tsconfig, which the shared schema uses.
COPY tsconfig.json ./
# The document schema and everything it reaches. Kept to the few files the
# server actually needs rather than the whole src tree, so an unrelated import
# creeping into this graph fails the build instead of quietly bloating the image.
COPY src/lib/tiptap-schema.ts src/lib/sprint-planning-doc.ts ./src/lib/
COPY src/components/tiptap/note-annotation-mark.ts src/components/tiptap/text-direction.ts ./src/components/tiptap/
COPY src/generated ./src/generated
COPY start-collab.sh ./
RUN chmod +x start-collab.sh

CMD ["./start-collab.sh"]
