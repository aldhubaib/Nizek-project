{
  "name": "nizek-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-next-cache.mjs",
    "dev": "NODE_OPTIONS='--max-old-space-size=6144' next dev",
    "prebuild": "node scripts/check-next-cache.mjs",
    "build": "NODE_OPTIONS='--max-old-space-size=2048' prisma generate && NODE_OPTIONS='--max-old-space-size=2048' next build",
    "start": "NODE_OPTIONS='--max-old-space-size=2048' next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:icons": "node scripts/generate-pwa-icons.mjs",
    "db:migrate": "node prisma/migrate.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "analyze": "ANALYZE=true npm run build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1083.0",
    "@base-ui/react": "^1.4.1",
    "@clerk/nextjs": "^7.3.5",
    "@clerk/themes": "^2.4.57",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@types/web-push": "^3.6.4",
    "centrifuge": "^5.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "shadcn": "^4.7.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tiptap": "^1.32.2",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
